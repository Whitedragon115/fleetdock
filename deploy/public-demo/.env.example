# Public demo settings. Copy to .env, fill in, then: chmod 600 .env
# Generate each secret with:  openssl rand -base64 33 | tr -d '/+=\n'

# Where visitors open the demo.
#   With a domain (HTTPS via Let's Encrypt; needs ports 80+443 and DNS):
#     FLEETDOCK_SITE_ADDRESS=demo.example.com
#     FLEETDOCK_PUBLIC_URL=https://demo.example.com
#   IP only (plain HTTP):
#     FLEETDOCK_SITE_ADDRESS=http://203.0.113.10
#     FLEETDOCK_PUBLIC_URL=http://203.0.113.10
FLEETDOCK_SITE_ADDRESS=
FLEETDOCK_PUBLIC_URL=

FLEETDOCK_JWT_SECRET=
FLEETDOCK_ENCRYPTION_KEY=
FLEETDOCK_ADMIN_PASSWORD=
FLEETDOCK_POSTGRES_PASSWORD=
# MySQL root, and Fleetdock's login on the sandbox. Letters and digits only.
SANDBOX_SUPERUSER_PASSWORD=
SANDBOX_ADMIN_PASSWORD=

# How often visitors' changes are thrown away (seconds), and how long their
# query history and saved queries are kept.
DEMO_RESET_INTERVAL_SECONDS=3600
DEMO_CLEANUP_AGE=1h
